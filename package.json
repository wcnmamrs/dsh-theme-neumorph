{
  "name": "dsh-theme-neumorph",
  "version": "1.0.3",
  "description": "DSH 新拟态主题插件：冷灰表面、钢蓝强调、柔和阴影。",
  "license": "MIT",
  "author": "wcnmamrs",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "neumorphism",
    "soft-ui",
    "skin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wcnmamrs/dsh-theme-neumorph.git"
  },
  "homepage": "https://github.com/wcnmamrs/dsh-theme-neumorph#readme",
  "bugs": {
    "url": "https://github.com/wcnmamrs/dsh-theme-neumorph/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check client.js && node --check index.js",
    "verify": "npm run check && npm test",
    "pack:check": "npm pack --dry-run"
  }
}
